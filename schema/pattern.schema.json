{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gtracker pattern v1",
  "description": "Native validation additionally checks byte lengths, unique event IDs, event beat < length_beats and string number <= tuning length.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "revision",
    "tempo_bpm",
    "length_beats",
    "seed",
    "instrument",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tempo_bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 400
    },
    "length_beats": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 256
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuning_midi",
        "decay_seconds",
        "brightness",
        "body_mix"
      ],
      "properties": {
        "tuning_midi": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 16,
            "maximum": 95
          }
        },
        "decay_seconds": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 60
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "body_mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "beat",
          "strength"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "enum": [
              "pluck",
              "damp",
              "body_hit"
            ]
          },
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "string": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "fret": {
            "type": "number",
            "minimum": 0,
            "maximum": 36
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "oneOf": [
          {
            "properties": {
              "type": {
                "const": "pluck"
              }
            },
            "required": [
              "string",
              "fret"
            ]
          },
          {
            "properties": {
              "type": {
                "const": "damp"
              }
            },
            "required": [
              "string"
            ],
            "not": {
              "required": [
                "fret"
              ]
            }
          },
          {
            "properties": {
              "type": {
                "const": "body_hit"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "string"
                  ]
                },
                {
                  "required": [
                    "fret"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
