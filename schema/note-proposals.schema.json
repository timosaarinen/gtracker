{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gtracker optional monophonic note proposals v1",
  "description": "Readers additionally check source/take/alignment identity, exact score snapshot, unique IDs/strings, ordered selection bounds and pitch-compatible alternatives. Scores are diagnostics, not probabilities. Acceptance adds selected plucks only.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "take_id", "source_pattern_revision", "source_pattern", "source", "alignment", "status", "parameters", "notes", "limitations", "provenance"],
  "properties": {
    "schema": {"const": "gtracker.note-proposals"}, "version": {"type": "integer", "const": 1},
    "job_id": {"$ref": "#/$defs/id"}, "take_id": {"$ref": "#/$defs/id"},
    "source_pattern_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "source_pattern": {"oneOf": [{"$ref": "pattern.schema.json"}, {"$ref": "pattern-v2.schema.json"}]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "frames", "sample_rate_hz", "channels", "channel"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"}, "frames": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "channels": {"type": "integer", "minimum": 1, "maximum": 2}, "channel": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "alignment": {"$ref": "take.schema.json#/properties/alignment"},
    "status": {"enum": ["proposals", "no_confident_candidates"]},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["min_hz", "max_hz", "analysis_rate_hz", "box_decimation_factor", "difference_window_samples", "hop_samples", "rms_gate", "minimum_voiced_frames", "maximum_gap_frames", "default_render_strength", "assumed_monophonic", "technique_recognition", "timing_quantized"],
      "properties": {
        "min_hz": {"const": 65}, "max_hz": {"const": 1000},
        "analysis_rate_hz": {"type": "number", "minimum": 8000, "maximum": 16000},
        "box_decimation_factor": {"type": "integer", "minimum": 1, "maximum": 24},
        "difference_window_samples": {"type": "integer", "minimum": 256, "maximum": 640},
        "hop_samples": {"type": "integer", "minimum": 80, "maximum": 160},
        "rms_gate": {"type": "number", "minimum": 0.001, "maximum": 1},
        "minimum_voiced_frames": {"type": "integer", "const": 8}, "maximum_gap_frames": {"type": "integer", "const": 2},
        "default_render_strength": {"$ref": "#/$defs/score"},
        "assumed_monophonic": {"const": true}, "technique_recognition": {"const": false}, "timing_quantized": {"const": false}
      }
    },
    "notes": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "onset_frame", "end_frame", "pitch_midi", "periodicity", "voiced_fraction", "pitch_spread_cents", "onset_uncertainty_frames", "alternatives"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "onset_frame": {"$ref": "#/$defs/frame"}, "end_frame": {"$ref": "#/$defs/frame"},
          "pitch_midi": {"type": "number", "minimum": 0, "maximum": 127},
          "periodicity": {"$ref": "#/$defs/score"}, "voiced_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "pitch_spread_cents": {"type": "number", "minimum": 0, "maximum": 100},
          "onset_uncertainty_frames": {"type": "integer", "minimum": 1, "maximum": 192000},
          "alternatives": {
            "type": "array", "maxItems": 12,
            "items": {"type": "object", "additionalProperties": false, "required": ["string", "fret"],
              "properties": {"string": {"type": "integer", "minimum": 1, "maximum": 12}, "fret": {"type": "number", "minimum": 0, "maximum": 36}}}
          }
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "engine_version", "source_code_sha256", "python", "created_utc", "renderer_version", "renderer_build_id"],
      "properties": {
        "engine": {"const": "gtracker.monophonic-yin"}, "engine_version": {"const": "0.1.0"},
        "source_code_sha256": {"$ref": "#/$defs/hash"}, "python": {"$ref": "#/$defs/id"},
        "created_utc": {"$ref": "#/$defs/id"}, "renderer_version": {"$ref": "#/$defs/id"}, "renderer_build_id": {"$ref": "#/$defs/id"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "score": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
